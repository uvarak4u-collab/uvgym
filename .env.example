# Copy this file to .env and fill in the values. Never commit .env.

# Local development: leave empty (or use pglite://.data/uvgym) for a database stored on this computer.
# Neon / Vercel: Neon dashboard → your project → "Connect" → copy the connection string
DATABASE_URL=

# Long random string used to sign login cookies (npm run dev generates one for you)
JWT_SECRET=
